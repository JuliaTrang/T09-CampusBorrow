# Mẫu biến môi trường. Copy thành .env rồi điền giá trị thật. Không commit .env.
APP_ENV=development
PORT=3000
# Supabase pooler (transaction mode) cho app chạy trên Vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Kết nối trực tiếp, chỉ dùng cho Prisma migrate
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=
