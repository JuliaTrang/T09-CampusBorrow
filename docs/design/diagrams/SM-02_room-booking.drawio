"24" height="24" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;html=1;shape=endState;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="451" y="800" width="28" height="28" as="geometry"/></mxCell><mxCell id="f2" value="" style="ellipse;html=1;shape=endState;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="1051" y="800" width="28" height="28" as="geometry"/></mxCell><mxCell id="SM-02-1" value="submit(input, actor)&lt;br&gt;[periods in one session; start &amp;gt; now;&lt;br&gt;1 ≤ headcount ≤ capacity; no Approved overlap]&lt;br&gt;/ BOOKING_SUBMITTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1" target="PENDING"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="165" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-02-2" value="decide(bookingId, APPROVE, expectedVersion, actor)&lt;br&gt;[still eligible; no Approved overlap]&lt;br&gt;/ BOOKING_APPROVED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="APPROVED"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-28" as="offset"/></mxGeometry></mxCell><mxCell id="SM-02-3" value="decide(bookingId, APPROVE, expectedVersion, actor)&lt;br&gt;[overlap (23P01) or stale version]&lt;br&gt;/ 409; booking unchanged" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="PENDING"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="278"/><mxPoint x="300" y="302"/></Array><mxPoint x="-160" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-02-4" value="decide(bookingId, REJECT, expectedVersion, actor)&lt;br&gt;[reason 1–500 after trimming]&lt;br&gt;/ BOOKING_REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="REJECTED"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-02-5" value="cancel(bookingId, reason, expectedVersion, actor)&lt;br&gt;[owner; now &amp;lt; startAt; optional reason]&lt;br&gt;/ BOOKING_CANCELLED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="CANCELLED"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="308"/><mxPoint x="720" y="690"/></Array></mxGeometry></mxCell><mxCell id="SM-02-6" value="cancel(bookingId, reason, expectedVersion, actor)&lt;br&gt;[owner; now &amp;lt; startAt]&lt;br&gt;/ release interval; BOOKING_CANCELLED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.235;exitY=1;exitDx=0;exitDy=0;entryX=0.235;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="APPROVED" target="CANCELLED"><mxGeometry x="-0.4" relative="1" as="geometry"><mxPoint x="-110" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-02-7" value="voidApproval(bookingId, expectedVersion, tx)&lt;br&gt;[CO-04; now &amp;lt; startAt]&lt;br&gt;/ release interval once" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.765;exitY=1;exitDx=0;exitDy=0;entryX=0.765;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="APPROVED" target="CANCELLED"><mxGeometry x="0.4" relative="1" as="geometry"><mxPoint x="110" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-02-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="REJECTED" target="f1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-02-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CANCELLED" target="f2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-02-10" value="A Pending booking reserves no interval, and Pending bookings never block each other. An APPROVED booking stays APPROVED after its end time; there is no COMPLETED state. Setting the room Out of service does not change its approved bookings (FR-07-08)." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1300" y="250" width="560" height="62" as="geometry"/></mxCell><mxCell id="SM-02-11" value="&lt;b&gt;Notation&lt;/b&gt;: event(parameters) [guard] / action or history event. Events are the operations declared in CD-01. Solid arrow: normal lifecycle. Dashed arrow: Admin correction (BR-20, Should); it also appends STATE_CORRECTED." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1300" y="330" width="560" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>