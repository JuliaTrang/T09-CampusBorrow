        <mxCell id="c01" value="&lt;b&gt;CMP-01 AuthModule&lt;/b&gt;&lt;br&gt;[Component: NestJS module]&lt;br&gt;AuthController, AuthService, SessionGuard, RolesGuard&lt;br&gt;UC-01, UC-02" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=12;fillColor=#EFF6FF;strokeColor=#111827;fontColor=#111827;" vertex="1" parent="b">
          <mxGeometry x="20" y="80" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;SessionGuard and RolesGuard (CMP-01) run before every protected route (NFR-03).&lt;br&gt;&lt;br&gt;Every module uses CMP-09; those arrows are not drawn.&lt;br&gt;&lt;br&gt;CMP-02 increments token_version itself (ADR-003), so it does not depend on CMP-01.&lt;br&gt;&lt;br&gt;Controllers only accept requests and return responses; business rules live in the services." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#111827;strokeColor=#111827;fillColor=#FFFFFF;spacing=8;" vertex="1" parent="b">
          <mxGeometry x="20" y="230" width="210" height="240" as="geometry" />
        </mxCell>
