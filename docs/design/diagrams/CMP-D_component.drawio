<mxfile host="drawio" version="24.7.17">
  <diagram id="cmp-d" name="CMP-D Component">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
