<mxfile host="app.diagrams.net"><diagram name="SM-04" id="SM-04"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SM-04 · State machine Resource (operationalStatus)&lt;/b&gt;&lt;br&gt;PA3 §4.5 · Team T09 · last edited 2026-11-22 · events are CD-01 operations" style="text;html=1;align=left;verticalAlign=top;spacing=8;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="560" height="46" as="geometry"/></mxCell><mxCell id="OUT_OF_SERVICE" value="OUT_OF_SERVICE" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="170" height="60" as="geometry"/></mxCell><mxCell id="IN_SERVICE" value="IN_SERVICE" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1100" y="260" width="170" height="60" as="geometry"/></mxCell><mxCell id="i1" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="278" width="24" height="24" as="geometry"/></mxCell><mxCell id="SM-04-1" value="create(input, actor)&lt;br&gt;[RM or Admin; valid input]&lt;br&gt;/ HIDDEN; reason &quot;Awaiting readiness confirmation&quot;;&lt;br&gt;RESOURCE_CREATED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1" target="OUT_OF_SERVICE"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-04-2" value="changeStatus(resourceId, IN_SERVICE, expectedVersion, actor)&lt;br&gt;[RM or Admin; current version]&lt;br&gt;/ clear reason; OPERATIONAL_STATUS_CHANGED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="OUT_OF_SERVICE" target="IN_SERVICE"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="SM-04-3" value="changeStatus(resourceId, OUT_OF_SERVICE, expectedVersion, actor)&lt;br&gt;[reason 1–500 after trimming; current version]&lt;br&gt;/ OPERATIONAL_STATUS_CHANGED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="IN_SERVICE" target="OUT_OF_SERVICE"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="400"/><mxPoint x="585" y="400"/></Array></mxGeometry></mxCell><mxCell id="SM-04-4" value="Visibility (VISIBLE, HIDDEN) is changed by changeStatus(resourceId, VISIBLE | HIDDEN, …) and is independent of this state machine. Neither change cancels, releases or reassigns existing requests, reservations, loans or bookings (FR-02-09, FR-07-08). Resources are never deleted." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="560" height="62" as="geometry"/></mxCell><mxCell id="SM-04-5" value="&lt;b&gt;Notation&lt;/b&gt;: event(parameters) [guard] / action or history event. Events are the operations declared in CD-01. Solid arrow: normal lifecycle; there is no correction path for this object." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="900" y="548" width="560" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>