fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" connectable="0" parent="c43"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c46" value="STATE_CORRECTED" style="endArrow=none;html=1;rounded=0;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" connectable="0" parent="c46"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c48" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" connectable="0" parent="c46"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c49" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Names follow the PA3 kickoff glossary. RevokedToken.id is the jti of the JWT; it is not a session table (ADR-003). expiry_at and Overdue are computed, not stored. Reservation = APPROVED and Loan = ON_LOAN are states of EquipmentRequest. Other enumerations (Role, ResourceType, Visibility, OperationalStatus, CancellationCause, TargetType, CorrectionOperation, HistoryEventType) are listed in the kickoff glossary. The common columns createdAt and updatedAt (kickoff rule) are not drawn." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1150" y="250" width="330" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>