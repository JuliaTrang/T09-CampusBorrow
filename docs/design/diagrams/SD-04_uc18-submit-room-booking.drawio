ng&lt;br&gt;requests do not block each other. Approval uses the ADR-004 GiST exclusion and returns 409 on&lt;br&gt;overlap." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="773" y="694" width="600" height="84" as="geometry"/></mxCell><mxCell id="c25" value="Save as PENDING with the session borrowerId and no room reservation. Commit the request and its&lt;br&gt;audit together." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="773" y="1012" width="600" height="42" as="geometry"/></mxCell><mxCell id="c26" value="canActivate(cookie)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="158" y="170" as="sourcePoint"/><mxPoint x="400" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="Principal, or 401" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="210" as="sourcePoint"/><mxPoint x="158" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="authorize(principal, Borrower)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="158" y="250" as="sourcePoint"/><mxPoint x="620" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="Allow, or 403" style="html=1