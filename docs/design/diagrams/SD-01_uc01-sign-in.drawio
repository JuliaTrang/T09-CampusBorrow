]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="95" y="526" width="780" height="20" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="45" y="528" as="sourcePoint"/><mxPoint x="885" y="528" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="Trim and lowercase the&lt;br&gt;identifier. Keep the&lt;br&gt;password exactly as&lt;br&gt;typed (UTF-8). Read&lt;br&gt;the account and&lt;br&gt;tokenVersion. Verify&lt;br&gt;the pre-hashed bcrypt&lt;br&gt;(cost 12). Run a dummy&lt;br&gt;bcrypt comparison when&lt;br&gt;the account does not&lt;br&gt;exist." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="500" y="232" width="150" height="168" as="geometry"/></mxCell><mxCell id="c16" value="Sign an HS256 JWT with&lt;br&gt;sub, jti, tv, iat and&lt;br&gt;exp (exp = iat + 24&lt;br&gt;h). No session row is&lt;br&gt;created (ADR-003)." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="500" y="634" width="150" height="84" as="geometry"/></mxCell><mxCell id="c17" value="login(identifier, password)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="170" as="sourcePoint"/><mxPoint x="355" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="login(identifier, password)" style="html=1;verticalAlign=bottom;