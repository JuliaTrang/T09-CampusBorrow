<mxfile host="app.diagrams.net"><diagram id="C4-L1" name="C4-L1 System Context"><mxGraphModel dx="1400" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="990" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4-L1 · System Context – CampusBorrow&lt;/b&gt;&lt;br&gt;Team T09 TetraBo · PA3 §3.2 · last edited 2026-11-17" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;align=left;spacingLeft=10;fillColor=#ffffff;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="430" height="58" as="geometry"/></mxCell><mxCell id="borrower_head" value="" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;ellipse;fillColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="154.0" y="98" width="52" height="52" as="geometry"/></mxCell><mxCell id="borrower" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Borrower&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Student or student-club representative with the Borrower role" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;rounded=1;arcSize=14;fillColor=#2563EB;fontColor=#ffffff;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="130" as="geometry"/></mxCell><mxCell id="prospect_head" value="" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;ellipse;fillColor=#C2410C;" vertex="1" parent="1"><mxGeometry x="489.0" y="98" width="52" height="52" as="geometry"/></mxCell><mxCell id="prospect" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Prospective Borrower&lt;/b&gt;&lt;br&gt;[Person, unauthenticated]&lt;br&gt;&lt;br&gt;Visitor who registers a Borrower account; not a fourth role" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;rounded=1;arcSize=14;fillColor=#C2410C;fontColor=#ffffff;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="375" y="150" width="280" height="130" as="geometry"/></mxCell><mxCell id="rm_head" value="" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;ellipse;fillColor=#15803D;" vertex="1" parent="1"><mxGeometry x="859.0" y="98" width="52" height="52" as="geometry"/></mxCell><mxCell id="rm" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Resource Manager&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Unit staff with equal unit-wide operational access; no resource assignment (BR-01)" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;rounded=1;arcSize=14;fillColor=#15803D;fontColor=#ffffff;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="745" y="150" width="280" height="130" as="geometry"/></mxCell><mxCell id="admin_head" value="" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;ellipse;fillColor=#7E22CE;" vertex="1" parent="1"><mxGeometry x="1194.0" y="98" width="52" height="52" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Admin&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Account administration, operational support and controlled corrections" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;rounded=1;arcSize=14;fillColor=#7E22CE;fontColor=#ffffff;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="280" height="130" as="geometry"/></mxCell><mxCell id="system" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;CampusBorrow&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Responsive web application for equipment lending and classroom booking in one simulated unit. Enforces roles, ownership, reservation exclusivity, room-overlap rules and capped pickup expiry, and keeps an append-only business history. Times shown in UTC+7." style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;rounded=1;arcSize=4;fillColor=#475569;fontColor=#ffffff;verticalAlign=top;spacingTop=10;spacingLeft=20;spacingRight=20;" vertex="1" parent="1"><mxGeometry x="290" y="580" width="820" height="150" as="geometry"/></mxCell><mxCell id="rel0" value="Signs in and out; browses the catalogue and room schedules; submits, tracks and cancels own equipment requests and room bookings; views own history&lt;br&gt;&lt;b&gt;[HTTPS, web browser]&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeColor=#111827;fontFamily=Inter;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;whiteSpace=wrap;exitX=0.5;exitY=1;entryX=0.1707;entryY=0;" edge="1" parent="1" source="borrower" target="system"><mxGeometry x="-0.30" width="290" relative="1" as="geometry"/></mxCell><mxCell id="rel1" value="Registers a Borrower account (UC-06)&lt;br&gt;&lt;b&gt;[HTTPS, web browser]&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeColor=#111827;fontFamily=Inter;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;whiteSpace=wrap;exitX=0.5;exitY=1;entryX=0.3659;entryY=0;" edge="1" parent="1" source="prospect" target="system"><mxGeometry x="0.50" width="290" relative="1" as="geometry"/></mxCell><mxCell id="rel2" value="Maintains the catalogue; approves or rejects requests; changes pickup appointments; records handover and return; follows up overdue loans&lt;br&gt;&lt;b&gt;[HTTPS, web browser]&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeColor=#111827;fontFamily=Inter;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;whiteSpace=wrap;exitX=0.5;exitY=1;entryX=0.6341;entryY=0;" edge="1" parent="1" source="rm" target="system"><mxGeometry x="-0.30" width="290" relative="1" as="geometry"/></mxCell><mxCell id="rel3" value="Manages accounts, roles and manual password resets; supports request processing; applies controlled state corrections (CO-01 – CO-04)&lt;br&gt;&lt;b&gt;[HTTPS, web browser]&lt;/b&gt;" style="endArrow=block;endFill=1;html=1;strokeColor=#111827;fontFamily=Inter;fontSize=14;fontColor=#111827;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;whiteSpace=wrap;exitX=0.5;exitY=1;entryX=0.8293;entryY=0;" edge="1" parent="1" source="admin" target="system"><mxGeometry x="0.56" width="290" relative="1" as="geometry"/></mxCell><mxCell id="outside" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Outside the CampusBorrow boundary (no system-to-system integration)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;rounded=1;arcSize=2;dashed=1;dashPattern=7 5;fillColor=#ffffff;fontColor=#111827;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1320" height="200" as="geometry"/></mxCell><mxCell id="phys" value="Physical activities – performed by staff, then recorded in CampusBorrow:&lt;br&gt;• identity check before a manual password reset (BR-09)&lt;br&gt;• equipment collection (handover) and physical return (DR-07)&lt;br&gt;• handling of approved bookings for a room later set Out of service (FR-07-08)" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="806" width="640" height="100" as="geometry"/></mxCell><mxCell id="excl" value="Excluded integrations – out of scope in PA1 and PA2 §2.1:&lt;br&gt;• email / SMS notifications, SSO, real-time chat&lt;br&gt;• academic timetable and event management&lt;br&gt;• payments, deposits and monetary penalties; native mobile apps" style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="740" y="806" width="600" height="100" as="geometry"/></mxCell><mxCell id="legend" value="Notation: C4 model. Rounded shapes with a head = person; dark box = the software system; solid arrow = &amp;quot;uses&amp;quot; with the protocol in brackets. Colour identifies the actor only; every element also has a text label." style="whiteSpace=wrap;html=1;fontFamily=Inter;fontSize=14;strokeColor=#111827;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="56" y="914" width="1290" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>