rent="1" source="r_accounts_id" target="r_state_corrections_admin_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2030" y="131.0"/><mxPoint x="2030" y="605.0"/></Array></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_history_events_id" target="r_state_corrections_history_event_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2660" y="131.0"/><mxPoint x="2660" y="627.0"/></Array></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#4d4d4d;strokeWidth=1.2;" edge="1" parent="1" source="r_resources_id" target="r_history_events_resource_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="15" y="131.0"/><mxPoint x="15" y="1106"/><mxPoint x="2050" y="1106"/><mxPoint x="2050" y="263.0"/></Array></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;ERD-01 · CampusBorrow · 3NF&lt;/b&gt;&lt;br&gt;PA3 §5.1 · Team T09 · last edited 2026-11-22 · columns and types follow the Table Specification (§5.2)" style="text;html=1;align=left;verticalAlign=top;spacing=8;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="760" height="50" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK primary key · FK foreign key · UK unique&lt;br&gt;Every foreign key has its own line, from the referenced key to its FK column.&lt;br&gt;|| at the parent: FK NOT NULL (solid line) · o| at the parent: FK may be NULL (dashed line)&lt;br&gt;o&amp;lt; at the child: zero or more rows · o| at the child: at most one row (unique FK)&lt;br&gt;target_id in history_events and state_corrections is polymorphic and has no FK (§5.3)." style="text;html=1;align=left;verticalAlign=top;spacing=8;strokeColor=#111827;fillColor=#f5f5f5;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="560" height="110" as="geometry"/></mxCell><mxCell id="cons" value="&lt;b&gt;Key constraints (§5.3)&lt;/b&gt;&lt;br&gt;• equipment_requests: UNIQUE (resource_id) WHERE status IN (APPROVED, ON_LOAN); UNIQUE (borrower_id, resource_id) WHERE status IN (PENDING, APPROVED, ON_LOAN)&lt;br&gt;• room_bookings: EXCLUDE USING gist (resource_id WITH =, tstzrange(start_at, end_at, &#x27;[)&#x27;) WITH &amp;amp;&amp;amp;) WHERE status = APPROVED (btree_gist)&lt;br&gt;• resources: CHECK (operational_status = OUT_OF_SERVICE) = (out_of_service_reason IS NOT NULL); a new resource gets the system reason &quot;Awaiting readiness confirmation&quot; (BR-13)&lt;br&gt;• expiry_at and overdue are computed, not stored (ADR-005)" style="text;html=1;align=left;verticalAlign=top;spacing=8;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1400" y="620" width="560" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>