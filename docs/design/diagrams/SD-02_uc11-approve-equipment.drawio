Family=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="992" width="1498" height="20" as="geometry"/></mxCell><mxCell id="c12" value="[else: transaction commits]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="1098" width="1498" height="20" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="1100" as="sourcePoint"/><mxPoint x="1650" y="1100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=20;fillColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="78" y="640" width="1586" height="588" as="geometry"/></mxCell><mxCell id="c15" value="[invalid input, stale state, lost authority or conflict]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="128" y="646" width="1526" height="20" as="geometry"/></mxCell><mxCell id="c16" value="[else: eligible approval or valid rejection]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="128" y="808" width="1526" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78" y="810" as="sourcePoint"/><mxPoint x="1664" y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Proceed only if both guards allow." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="94" y="312" width="870" height="28" as="geometry"/></mxCell><mxCell id="c19" value="Inside the transaction: lock the resources row first, then read&lt;br&gt;the request and occupancy, and recheck the role, the Pending&lt;br&gt;state and eligibility. Approval: the confirmed pickup is in the&lt;br&gt;future and before the unchanged return due time; reserve the&lt;br&gt;item and reject every competing Pending request. Rejection: a&lt;br&gt;reason of 1-500 characters is required. Borrower inactivity&lt;br&gt;alone does not block approval." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="434" width="396" height="112" as="geometry"/></mxCell><mxCell id="c20" value="409 on a stale version or state. Keep the competing committed&lt;br&gt;result." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="674" width="396" height="42" as="geometry"/></mxCell><mxCell id="c21" value="Approval also writes audit for the winner and for each&lt;br&gt;automatic rejection. Conditional update on state and version.&lt;br&gt;Commit state, reservation and history together." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="916" width="396" height="56" as="geometry"/></mxCell><mxCell id="c22" value="canActivate(cookie)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="170" as="sourcePoint"/><mxPoint x="422" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="Principal, or 401" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="422" y="210" as="sourcePoint"/><mxPoint x="168" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="authorize(principal, RM_or_Admin)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="250" as="sourcePoint"/><mxPoint x="642" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Allow, or 403" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="290" as="sourcePoint"/><mxPoint x="168" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="decide(requestId, decision, expectedVersion, actor)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="372" as="sourcePoint"/><mxPoint x="888" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="$transaction(currentDecision)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="412" as="sourcePoint"/><mxPoint x="1134" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="now()" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="578" as="sourcePoint"/><mxPoint x="1354" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="serverNow" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1354" y="618" as="sourcePoint"/><mxPoint x="888" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="Failure with the current authorised result" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1134" y="748" as="sourcePoint"/><mxPoint x="888" y="748" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Action rejected, no partial change" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="788" as="sourcePoint"/><mxPoint x="168" y="788" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="append(decisionEvent, tx)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="854" as="sourcePoint"/><mxPoint x="1574" y="854" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="Stored, or failure" style="html=1;verticalA