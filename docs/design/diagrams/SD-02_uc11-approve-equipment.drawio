<mxfile host="app.diagrams.net"><diagram name="SD-02" id="SD-02"><mxGraphModel dx="1724" dy="1308" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1724" pageHeight="1308" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;SD-02 · UC-11 Approve or reject an equipment request&lt;/b&gt;&lt;br&gt;PA3 §4.4 · Team T09 · last edited 2026-11-18" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="420" height="44" as="geometry"/></mxCell><mxCell id="c3" value="RM or Admin via controller" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#15803D;fontFamily=Arial;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="217" height="1168" as="geometry"/></mxCell><mxCell id="c4" value=":SessionGuard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="347" y="80" width="150" height="1168" as="geometry"/></mxCell><mxCell id="c5" value=":RolesGuard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="567" y="80" width="150" height="1168" as="geometry"/></mxCell><mxCell id="c6" value=":EquipmentRequestService" st