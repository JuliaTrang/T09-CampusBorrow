<mxfile host="app.diagrams.net"><diagram name="SD-03" id="SD-03"><mxGraphModel dx="1724" dy="1356" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1724" pageHeight="1356" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;SD-03 · UC-13 Record equipment handover&lt;/b&gt;&lt;br&gt;PA3 §4.4 · Team T09 · last edited 2026-11-21" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="420" height="44" as="geometry"/></mxCell><mxCell id="c3" value="RM or Admin via controller" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#15803D;fontFamily=Arial;fontSize=12;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="217" height="1216" as="geometry"/></mxCell><mxCell id="c4" value=":SessionGuard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="347" y="80" width="150" height="1216" as="geometry"/></mxCell><mxCell id="c5" value=":RolesGuard" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="567" y="80" width="150" height="1216" as="geometry"/></mxCell><mxCell id="c6" value=":EquipmentRequestService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="787" y="80" width="202" height="1216" as="geometry"/></mxCell><mxCell id="c7" value=":PrismaService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1059" y="80" width="150" height="1216" as="geometry"/></mxCell><mxCell id="c8" value=":Clock" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1279" y="80" width="150" height="1216" as="geometry"/></mxCell><mxCell id="c9" value=":HistoryService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=44;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1499" y="80" width="150" height="1216" as="geometry"/></mxCell><mxCell id="c10" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=20;fillColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="92" y="1034" width="1558" height="226" as="geometry"/></mxCell><mxCell id="c11" value="[persistence, history or commit fails]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="1040" width="1498" height="20" as="geometry"/></mxCell><mxCell id="c12" value="[else: commit succeeds]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="1146" width="1498" height="20" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="1148" as="sourcePoint"/><mxPoint x="1650" y="1148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=20;fillColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="78" y="744" width="1586" height="532" as="geometry"/></mxCell><mxCell id="c15" value="[too early, expired, inactive borrower, out of service, stale state or no reservation]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="128" y="750" width="1526" height="20" as="geometry"/></mxCell><mxCell id="c16" value="[else: eligible current handover]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="128" y="856" width="1526" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78" y="858" as="sourcePoint"/><mxPoint x="1664" y="858" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Continue only if both guards allow and the physical handover is confirmed." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="94" y="312" width="870" height="28" as="geometry"/></mxCell><mxCell id="c19" value="Lock the resources row first (READ COMMITTED). Reload the&lt;br&gt;request, reservation, borrower and actor. Required: the request&lt;br&gt;is Approved and uncollected, the reservation is the right one,&lt;br&gt;the borrower is active and the item is In service. A Hidden&lt;br&gt;item alone does not forbid handover." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="434" width="396" height="84" as="geometry"/></mxCell><mxCell id="c20" value="expiry = min(confirmedPickupAt + 24 h, returnDueAt). Required: confirmedPickupAt &amp;lt;= now &amp;lt; expiry." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="702" width="616" height="28" as="geometry"/></mxCell><mxCell id="c21" value="Same transaction: record the staff member and time, and convert&lt;br&gt;the reservation to a loan. No free gap in occupancy; serialised&lt;br&gt;with expiry and pickup edits." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="884" width="396" height="56" as="geometry"/></mxCell><mxCell id="c22" value="canActivate(cookie)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="170" as="sourcePoint"/><mxPoint x="422" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="Principal, or 401" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="422" y="210" as="sourcePoint"/><mxPoint x="168" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="authorize(principal, RM_or_Admin)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="250" as="sourcePoint"/><mxPoint x="642" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Allow, or 403" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="290" as="sourcePoint"/><mxPoint x="168" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="handover(requestId, actor)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="372" as="sourcePoint"/><mxPoint x="888" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="$transaction(convertReservationToLoan)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="412" as="sourcePoint"/><mxPoint x="1134" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="now()" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="640" as="sourcePoint"/><mxPoint x="1354" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="serverNow" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1354" y="680" as="sourcePoint"/><mxPoint x="888" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="Handover rejected, no loan. A due expiry follows ADR-005." style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1134" y="796" as="sourcePoint"/><mxPoint x="888" y="796" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="Handover denied even if the stored label is still Approved" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="836" as="sourcePoint"/><mxPoint x="168" y="836" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="append(handoverEvent, tx)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="972" as="sourcePoint"/><mxPoint x="1574" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="Stored, or failure" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1574" y="1012" as="sourcePoint"/><mxPoint x="888" y="1012" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="Rollback of all changes" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1134" y="1086" as="sourcePoint"/><mxPoint x="888" y="1086" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="Failure, no partial loan" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="1126" as="sourcePoint"/><mxPoint x="168" y="1126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="ON_LOAN and the actual handover time" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1134" y="1192" as="sourcePoint"/><mxPoint x="888" y="1192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="Success, return deadline unchanged" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="1232" as="sourcePoint"/><mxPoint x="168" y="1232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="expireIfDue(resourceId, tx)" style="html=1;align=left;spacingLeft=4;verticalAlign=middle;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="540" as="sourcePoint"/><mxPoint x="888" y="570" as="targetPoint"/><Array as="points"><mxPoint x="930" y="540"/><mxPoint x="930" y="570"/></Array></mxGeometry></mxCell><mxCell id="c39" value="ADR-005: inside the locked transaction, a due expiry is&lt;br&gt;applied first (CANCELLED, SYSTEM_EXPIRY, history event); the&lt;br&gt;handover is then refused and the expiry is kept." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1100" y="530" width="396" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>