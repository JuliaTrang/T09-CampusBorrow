 loan in one update, so there is no moment without either." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=13;fontColor=#111827;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1888" width="1800" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>