Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="950" width="1498" height="20" as="geometry"/></mxCell><mxCell id="c12" value="[else: commit succeeds]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="142" y="1056" width="1498" height="20" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="1058" as="sourcePoint"/><mxPoint x="1650" y="1058" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=20;fillColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="78" y="654" width="1586" height="532" as="geometry"/></mxCell><mxCell id="c15" value="[too early, expired, inactive borrower, out of service, stale state or no reservation]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="128" y="660" width="1526" height="20" as="geometry"/></mxCell><mxCell id="c16" value="[else: eligible current handover]" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="128" y="766" width="1526" height="20" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#111827;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="78" y="768" as="sourcePoint"/><mxPoint x="1664" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="Continue only if both guards allow and the physical handover is confirmed." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="94" y="312" width="870" height="28" as="geometry"/></mxCell><mxCell id="c19" value="Lock the resources row first (READ COMMITTED). Reload the&lt;br&gt;request, reservation, borrower and actor. Required: the request&lt;br&gt;is Approved and uncollected, the reservation is the right one,&lt;br&gt;the borrower is active and the item is In service. A Hidden&lt;br&gt;item alone does not forbid handover." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="434" width="396" height="84" as="geometry"/></mxCell><mxCell id="c20" value="expiry = min(confirmedPickupAt + 24 h, returnDueAt). Required: confirmedPickupAt &amp;lt;= now &amp;lt; expiry." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="612" width="616" height="28" as="geometry"/></mxCell><mxCell id="c21" value="Same transaction: record the staff member and time, and convert&lt;br&gt;the reservation to a loan. No free gap in occupancy; serialised&lt;br&gt;with expiry and pickup edits." style="shape=note;size=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="813" y="794" width="396" height="56" as="geometry"/></mxCell><mxCell id="c22" value="canActivate(cookie)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="170" as="sourcePoint"/><mxPoint x="422" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="Principal, or 401" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="422" y="210" as="sourcePoint"/><mxPoint x="168" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="authorize(principal, RM_or_Admin)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="250" as="sourcePoint"/><mxPoint x="642" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Allow, or 403" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="642" y="290" as="sourcePoint"/><mxPoint x="168" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="handover(requestId, actor)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="372" as="sourcePoint"/><mxPoint x="888" y="372" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="$transaction(convertReservationToLoan)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeColor=#111827;fontFamily=Arial;fontSize=11;fontColor=#111827;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="888" y="412" as="sourcePoint"/><mxPoint x="1134" y="412" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="now()" s