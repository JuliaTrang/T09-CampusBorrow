<mxfile host="app.diagrams.net"><diagram id="DEP-D" name="DEP-D Deployment"><mxGraphModel dx="1400" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1250" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;DEP-D · Deployment – CampusBorrow (production)&lt;/b&gt;&lt;br&gt;Team T09 TetraBo · PA3 §3.5 · last edited 2026-11-22" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=10;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="470" height="58" as="geometry"/></mxCell><mxCell id="device" value="«device»&lt;br&gt;&lt;b&gt;User device&lt;/b&gt; – desktop or smartphone&lt;br&gt;Borrower · Prospective Borrower · Resource Manager · Admin" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="330" height="340" as="geometry"/></mxCell><mxCell id="browser" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;latest two versions of Chrome, Edge, Firefox, Safari; 360 – 1920 px" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="48" y="205" width="294" height="230" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;CTN-01 Web App&lt;/b&gt; (running copy)&lt;br&gt;React SPA downloaded from the CDN&lt;br&gt;JWT cookie: HttpOnly · Secure · SameSite=Lax" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#475569;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="62" y="305" width="266" height="110" as="geometry"/></mxCell><mxCell id="dns" value="«cloud service»&lt;br&gt;&lt;b&gt;Cloudflare DNS&lt;/b&gt;&lt;br&gt;custom domain → Vercel (DNS only, not proxied)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="330" height="95" as="geometry"/></mxCell><mxCell id="uptime" value="«external service»&lt;br&gt;&lt;b&gt;Uptime monitor&lt;/b&gt;&lt;br&gt;UptimeRobot (free plan): checks every 5 minutes, e-mails the team" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="330" height="95" as="geometry"/></mxCell><mxCell id="laptop" value="«device»&lt;br&gt;&lt;b&gt;Developer laptop&lt;/b&gt; (4 members)&lt;br&gt;Windows or macOS · Node.js 24 LTS · Git&lt;br&gt;local PostgreSQL in Docker or the Supabase development project" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="330" height="200" as="geometry"/></mxCell><mxCell id="vercel" value="«cloud platform»&lt;br&gt;&lt;b&gt;Vercel&lt;/b&gt; (Hobby plan) – projects &lt;i&gt;web&lt;/i&gt; and &lt;i&gt;api&lt;/i&gt;" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#F3F4F6;" vertex="1" parent="1"><mxGeometry x="480" y="110" width="580" height="660" as="geometry"/></mxCell><mxCell id="edge" value="«node» &lt;b&gt;Vercel Edge Network&lt;/b&gt; (global CDN)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="505" y="205" width="530" height="210" as="geometry"/></mxCell><mxCell id="web" value="«artifact» &lt;b&gt;web&lt;/b&gt; – static React + Vite build&lt;br&gt;deploys CTN-01 Web App" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#475569;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="525" y="255" width="490" height="80" as="geometry"/></mxCell><mxCell id="edge_conf" value="TLS certificate for the custom domain · HTTP → HTTPS redirect&lt;br&gt;rewrite /api/* → &lt;i&gt;api&lt;/i&gt; project (same origin, first-party cookie)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="525" y="345" width="490" height="55" as="geometry"/></mxCell><mxCell id="fn" value="«executionEnvironment» &lt;b&gt;Vercel Functions&lt;/b&gt;&lt;br&gt;Node.js 24 LTS · region sin1 (Singapore)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="505" y="455" width="530" height="300" as="geometry"/></mxCell><mxCell id="api" value="«artifact» &lt;b&gt;api&lt;/b&gt; – NestJS + Prisma Client&lt;br&gt;deploys CTN-02 API Server" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#475569;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="525" y="510" width="490" height="85" as="geometry"/></mxCell><mxCell id="cmp" value="One deployable unit (ADR-002): CMP-01 Auth · CMP-02 Account · CMP-03 Catalog · CMP-04 EquipmentLoan · CMP-05 RoomBooking · CMP-06 History · CMP-07 Correction · CMP-08 Scheduler (ExpiryJob) · CMP-09 Common" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="525" y="605" width="490" height="75" as="geometry"/></mxCell><mxCell id="fn_conf" value="Vercel environment settings: DATABASE_URL, JWT_SECRET, JOB_SECRET" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="525" y="690" width="490" height="45" as="geometry"/></mxCell><mxCell id="supa" value="«cloud platform»&lt;br&gt;&lt;b&gt;Supabase&lt;/b&gt; – production project, ap-southeast-1 (Singapore)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#F3F4F6;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="500" height="660" as="geometry"/></mxCell><mxCell id="pg" value="«executionEnvironment» &lt;b&gt;PostgreSQL&lt;/b&gt; (managed by Supabase)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1225" y="205" width="450" height="400" as="geometry"/></mxCell><mxCell id="schema" value="«artifact» &lt;b&gt;campusborrow schema&lt;/b&gt;&lt;br&gt;Prisma migrations + hand-written SQL constraints&lt;br&gt;deploys CTN-03 Database" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#475569;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="250" width="410" height="90" as="geometry"/></mxCell><mxCell id="ext" value="Extensions: btree_gist (exclusion constraint) · pg_cron · pg_net" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1245" y="350" width="410" height="50" as="geometry"/></mxCell><mxCell id="vault" value="Supabase Vault: job secret&lt;br&gt;No platform backup on the Free plan (P10 is the only backup)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1245" y="410" width="410" height="85" as="geometry"/></mxCell><mxCell id="cron" value="pg_cron job &lt;b&gt;expire-sweep&lt;/b&gt;, every minute:&lt;br&gt;pg_net → POST /api/internal/jobs/expire (CMP-08)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1245" y="507" width="410" height="85" as="geometry"/></mxCell><mxCell id="pool" value="«node» &lt;b&gt;Supavisor connection pooler&lt;/b&gt;&lt;br&gt;transaction mode :6543 – API at runtime&lt;br&gt;session mode :5432 – migrations and backup" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1225" y="640" width="450" height="110" as="geometry"/></mxCell><mxCell id="gh" value="«cloud service» &lt;b&gt;GitHub&lt;/b&gt; – repository and GitHub Actions (GitHub-hosted Ubuntu runner, Node.js 24 LTS)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;shape=cube;size=12;direction=south;anchorPointDirection=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;spacingRight=16;fontSize=13;fillColor=#F3F4F6;" vertex="1" parent="1"><mxGeometry x="480" y="820" width="1220" height="200" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;ci.yml&lt;/b&gt; – every pull request&lt;br&gt;lint, typecheck, unit and API tests, build, Playwright E2E&lt;br&gt;PostgreSQL service container; no production access" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="505" y="875" width="370" height="125" as="geometry"/></mxCell><mxCell id="release" value="&lt;b&gt;release.yml&lt;/b&gt; – merge to main&lt;br&gt;prisma migrate deploy on the production database&lt;br&gt;(session-mode connection :5432, DIRECT_URL)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="875" width="370" height="125" as="geometry"/></mxCell><mxCell id="backup" value="&lt;b&gt;backup.yml&lt;/b&gt; – daily 02:00 UTC+7&lt;br&gt;pg_dump | age → encrypted artifact, kept 7 days (RPO ≤ 24 h)" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;rounded=0;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1285" y="875" width="390" height="125" as="geometry"/></mxCell><mxCell id="p1" value="P1 · DNS" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="device" target="dns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2" value="P2 · HTTPS :443" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=1;exitY=0.386;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3" value="P3 · HTTPS, rewrite /api/*" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="edge" target="fn"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p4" value="P4 · PostgreSQL&lt;br&gt;TLS :6543" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=1;exitY=0.79;exitDx=0;exitDy=0;entryX=0;entryY=0.473;entryDx=0;entryDy=0;" edge="1" parent="1" source="fn" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5" value="P5 · pooled connections" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pool" target="pg"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p6" value="P6 · HTTPS :443&lt;br&gt;every minute" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.465;entryDx=0;entryDy=0;" edge="1" parent="1" source="cron" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7" value="P7 · HTTPS :443" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.767;entryDx=0;entryDy=0;" edge="1" parent="1" source="uptime" target="fn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8" value="P8 · Git integration: preview per PR, production from main" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0.1803;exitY=0;exitDx=0;exitDy=0;entryX=0.3793;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="gh" target="vercel"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="p9" value="P9 · TLS :5432" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0.932;exitY=0;exitDx=0;exitDy=0;entryX=0.033;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="release" target="pool"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="p10" value="P10 · TLS :5432" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.567;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="backup" target="pool"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="p11" value="P11 · HTTPS&lt;br&gt;git push, PR" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;html=1;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;labelBorderColor=#9CA3AF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="laptop" target="gh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="envbox" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Other environments (same topology unless stated)&lt;/b&gt;" style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;fontSize=13;rounded=1;arcSize=2;dashed=1;dashPattern=7 5;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="1060" width="1670" height="175" as="geometry"/></mxCell><mxCell id="env_prev" value="&lt;b&gt;Preview / staging.&lt;/b&gt; Every pull request gets a Vercel preview deployment (web + api) connected to a separate Supabase &lt;i&gt;development&lt;/i&gt; project in Singapore, never to production data. The preview of the release pull request, seeded with the NFR-01 reference data, is the staging environment for the NFR-01, NFR-02 and NFR-06 tests (PA4)." style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="46" y="1092" width="540" height="110" as="geometry"/></mxCell><mxCell id="env_ci" value="&lt;b&gt;CI.&lt;/b&gt; ci.yml runs on a GitHub-hosted Ubuntu runner with a PostgreSQL service container and the same migrations, including the hand-written constraints. Tests use a fixed Clock and never connect to Supabase." style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="1092" width="520" height="110" as="geometry"/></mxCell><mxCell id="env_dev" value="&lt;b&gt;Development.&lt;/b&gt; Each member runs web (Vite dev server) and api (NestJS) on a laptop against local PostgreSQL in Docker or the development project. Secrets stay in local .env files that are not committed." style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="1092" width="530" height="110" as="geometry"/></mxCell><mxCell id="legend" value="Notation: UML deployment diagram. 3-D box = node («device», «executionEnvironment», «cloud platform», «cloud service»); dark box = deployed artifact of a container (CTN-xx); grey box = configuration or scheduled job; solid arrow = communication path with protocol and port; dashed arrow = DNS lookup or deployment trigger. P1 – P11 match the communication-path table in §3.5." style="fontFamily=Inter;strokeColor=#111827;fontColor=#111827;whiteSpace=wrap;html=1;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="46" y="1185" width="1630" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>