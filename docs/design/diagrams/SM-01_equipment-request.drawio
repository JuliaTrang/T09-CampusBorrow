Dx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="APPROVED"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-3" value="decide(requestId, REJECT, expectedVersion, actor)&lt;br&gt;[reason 1–500 after trimming]&lt;br&gt;/ EQ_REQUEST_REJECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="REJECTED"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="-170" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-4" value="decide(otherRequestId, APPROVE, …, actor)&lt;br&gt;[a competing request is approved]&lt;br&gt;/ EQ_REQUEST_AUTO_REJECTED (SYSTEM)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="REJECTED"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="135" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-5" value="cancel(requestId, reason, expectedVersion, actor)&lt;br&gt;[owner] / BORROWER; EQ_REQUEST_CANCELLED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="PENDING" target="CANCELLED"><mxGeometry x="0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="790"/></Array><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-6" value="changePickup(requestId, newPickupAt, expectedVersion, actor)&lt;br&gt;[RM; now &amp;lt; expiry_at] / PICKUP_CHANGED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="APPROVED" target="APPROVED"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="951" y="340"/><mxPoint x="1019" y="340"/></Array><mxPoint x="0" y="-24" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-7" value="cancel(requestId, reason, expectedVersion, actor)&lt;br&gt;[owner before handover] / BORROWER&lt;br&gt;[staff; item damaged or Out of service]&lt;br&gt;/ STAFF_OUT_OF_SERVICE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="APPROVED" target="CANCELLED"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint x="-135" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-8" value="expireIfDue(resourceId, tx)&lt;br&gt;[now ≥ expiry_at] / SYSTEM_EXPIRY;&lt;br&gt;EQ_REQUEST_EXPIRED (SYSTEM)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="APPROVED" target="CANCELLED"><mxGeometry x="0.35" relative="1" as="geometry"><mxPoint x="115" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="SM-01-9" value="handover(requestId, actor)&lt;br&gt;[confirmedPickupAt ≤ now &amp;lt; expiry_at;&lt;br&gt;Borrower active; item In service]&lt;br&gt;/ HANDOVER_RECORDED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="APPROVED" target="ON_LOAN"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-01-10" value="recordReturn(requestId, actor)&lt;br&gt;[physical receipt confirmed]&lt;br&gt;/ RETURN_RECORDED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ON_LOAN" target="RETURNED"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-01-11" value="voidHandover(requestId, expectedVersion, tx)&lt;br&gt;[CO-01; reservation not expired]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;dashPattern=6 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ON_LOAN" target="APPROVED"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1434" y="540"/><mxPoint x="1061" y="540"/></Array></mxGeometry></mxCell><mxCell id="SM-01-12" value="voidHandover(requestId, expectedVersion, tx)&lt;br&gt;[CO-01; reservation already expired]&lt;br&gt;/ SYSTEM_EXPIRY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;dashPattern=6 4;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ON_LOAN" target="CANCELLED"><mxGeometry x="-0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="1502" y="790"/></Array></mxGeometry></mxCell><mxCell id="SM-01-13" value="voidReturn(requestId, expectedVersion, tx)&lt;br&gt;[CO-02; no later reservation or loan;&lt;br&gt;account still a Borrower]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.765;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="RETURNED" target="ON_LOAN"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1885" y="300"/><mxPoint x="1530" y="300"/></Array></mxGeometry></mxCell><mxCell id="SM-01-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="REJECTED" target="f1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-01-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CANCELLED" target="f2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SM-01-16" value="RETURNED has no final transition: it ends the normal lifecycle, but the CO-02 correction can still leave it. correctEventTime(requestId, event, correctedAt, expectedVersion, tx) (CO-03) changes handedOverAt or returnedAt only; the state stays ON_LOAN or RETURNED. Expired and Overdue are computed values, not states (ADR-005). A refused operation can still commit a due expiry." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1200" y="850" width="770" height="72" as="geometry"/></mxCell><mxCell id="SM-01-17" value="&lt;b&gt;Notation&lt;/b&gt;: event(parameters) [guard] / action or history event. Events are the operations declared in CD-01. Solid arrow: normal lifecycle. Dashed arrow: Admin correction (BR-20, Should); it also appends STATE_CORRECTED." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1200" y="936" width="770" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>