<mxfile host="app.diagrams.net"><diagram name="SM-03" id="SM-03"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;SM-03 · State machine Account&lt;/b&gt;&lt;br&gt;PA3 §4.5 · Team T09 · last edited 2026-11-22 · events are CD-01 operations" style="text;html=1;align=left;verticalAlign=top;spacing=8;strokeColor=#111827;fillColor=#ffffff;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="560" height="46" as="geometry"/></mxCell><mxCell id="ACTIVE" value="ACTIVE" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="170" height="60" as="geometry"/></mxCell><mxCell id="INACTIVE" value="INACTIVE" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1100" y="260" width="170" height="60" as="geometry"/></mxCell><mxCell id="i1" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="278" width="24" height="24" as="geometry"/></mxCell><mxCell id="i2" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="24" height="24" as="geometry"/></mxCell><mxCell id="SM-03-1" value="register(input)&lt;br&gt;[public; Borrower role only]&lt;br&gt;/ ACCOUNT_REGISTERED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1" target="ACTIVE"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="290"/><mxPoint x="300" y="278"/></Array></mxGeometry></mxCell><mxCell id="SM-03-2" value="create(input, actor)&lt;br&gt;[active Admin; exactly one role]&lt;br&gt;/ ACCOUNT_CREATED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="ACTIVE"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="551" y="442"/></Array></mxGeometry></mxCell><mxCell id="SM-03-3" value="changeSecurity(accountId, ROLE_CHANGE | PASSWORD_RESET, actor)&lt;br&gt;[Admin; not own role; no outstanding obligations for a role change]&lt;br&gt;/ ROLE_CHANGED or PASSWORD_RESET; tokenVersion + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.35;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ACTIVE" target="ACTIVE"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="190"/><mxPoint x="610" y="190"/></Array><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="SM-03-4" value="changeSecurity(accountId, DEACTIVATE, actor)&lt;br&gt;[Admin; not own account; not the last active Admin]&lt;br&gt;/ ACCOUNT_DEACTIVATED; tokenVersion + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="ACTIVE" target="INACTIVE"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell><mxCell id="SM-03-5" value="changeSecurity(accountId, REACTIVATE, actor)&lt;br&gt;[Admin]&lt;br&gt;/ ACCOUNT_REACTIVATED; old tokens stay invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#111827;labelBackgroundColor=#ffffff;align=center;fontFamily=Arial;fontSize=11;fontColor=#111827;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="INACTIVE" target="ACTIVE"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="400"/><mxPoint x="627" y="400"/></Array></mxGeometry></mxCell><mxCell id="SM-03-6" value="Accounts are never deleted, so there is no final state. The first Admin is created by the setup seed (FR-09-08) and starts ACTIVE. Role and password changes keep the AccountStatus; they increment tokenVersion so every earlier JWT fails (ADR-003)." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="560" height="62" as="geometry"/></mxCell><mxCell id="SM-03-7" value="&lt;b&gt;Notation&lt;/b&gt;: event(parameters) [guard] / action or history event. Events are the operations declared in CD-01. Solid arrow: normal lifecycle; there is no correction path for this object." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8fafc;strokeColor=#64748b;fontFamily=Arial;fontSize=11;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="900" y="548" width="560" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>