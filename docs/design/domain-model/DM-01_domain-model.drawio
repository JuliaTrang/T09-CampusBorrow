3" as="geometry"/></mxCell><mxCell id="note_0" value="DM-01 · Domain Model — History and corrections" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=27;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="9" width="748.78" height="35" as="geometry"/></mxCell><mxCell id="note_1" value="View B of 2 · Append-only evidence and guarded administrative corrections" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#111827;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="57" width="705.12" height="24" as="geometry"/></mxCell><mxCell id="note_2" value="PA3 §4.1 • CampusBorrow • Owner: Phuc • Last modified: 2026-11-18" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=15;fontColor=#475569;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="591.25" height="23" as="geometry"/></mxCell><mxCell id="note_3" value="CONSTRAINTS" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=15;fontColor=#111827;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1105" width="113.35" height="23" as="geometry"/></mxCell><mxCell id="note_4" value="Each HistoryEvent has exactly ONE target across its four target associations. An absent actor means SYSTEM." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#111827;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1130" width="1026.08" height="24" as="geometry"/></mxCell><mxCell id="note_5" value="Each StateCorrection targets exactly ONE EquipmentRequest OR RoomBooking and records one primary correction event." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#111827;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1156" width="1092.1599999999999" height="24" as="geometry"/></mxCell><mxCell id="note_6" value="HistoryEvent and StateCorrection records are retained. Corrections append evidence; they do not overwrite earlier events." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#111827;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1182" width="1158.24" height="24" as="geometry"/></mxCell><mxCell id="note_7" value="«Should» is the agreed feature priority. Its authorization, reason and consistency guards remain mandatory when delivered." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#111827;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1208" width="1167.6799999999998" height="24" as="geometry"/></mxCell><mxCell id="note_8" value="Shaded classes repeat View A. Account is also repeated here to keep the Admin association readable." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=16;fontColor=#111827;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="1234" width="950.56" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>